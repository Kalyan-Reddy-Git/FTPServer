# ==============================================================================
# NetTransfer Environment Configuration Example
# Copy this file to '.env' and populate with your production secrets.
# ==============================================================================

# Flask Session Security Key (Generate a random 32-character string in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Flask Debug Mode (0 or False in production, 1 for local development)
FLASK_DEBUG=0

# Server HTTP Port
PORT=5000

# SQLite User Database Path (Optional, defaults to nettransfer.db in project root)
DATABASE_PATH=nettransfer.db

# Storage Root for Multi-Tenant Client Folders (Optional, defaults to demo_ftp_storage)
STORAGE_PATH=demo_ftp_storage

# Test FTP Server Binding
FTP_HOST=127.0.0.1
FTP_PORT=2121

# Default Admin/Lab Test Accounts
FTP_USER=student
FTP_PASS=student123
